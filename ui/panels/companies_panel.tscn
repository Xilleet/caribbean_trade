[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/panels/companies_panel.gd" id="1_co"]

[node name="CompaniesPanel" type="VBoxContainer"]
script = ExtResource("1_co")
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="."]
unique_name_in_owner = true
text = "— Companies —"

[node name="Header" type="HBoxContainer" parent="."]
unique_name_in_owner = true
theme_override_constants/separation = 0

[node name="HName" type="Button" parent="Header"]
unique_name_in_owner = true
text = "company"

[node name="HMoney" type="Button" parent="Header"]
unique_name_in_owner = true
text = "money"

[node name="HDelta" type="Button" parent="Header"]
unique_name_in_owner = true
text = "d/day"

[node name="HShips" type="Button" parent="Header"]
unique_name_in_owner = true
text = "ships"

[node name="HLoans" type="Button" parent="Header"]
unique_name_in_owner = true
text = "loans / status"

[node name="List" type="VBoxContainer" parent="."]
unique_name_in_owner = true
size_flags_vertical = 3
theme_override_constants/separation = 1

[node name="Sep" type="HSeparator" parent="."]
theme_override_constants/separation = 2

[node name="Summary" type="Label" parent="."]
unique_name_in_owner = true
